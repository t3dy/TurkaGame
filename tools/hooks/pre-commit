#!/bin/sh
# Pre-commit: enforce the house rules that used to live only in prose.
#
# Installed by `python tools/install_hooks.py`, which sets core.hooksPath to
# tools/hooks so this travels with the repo instead of sitting untracked in
# .git/hooks.
#
# Exists because 43 copyrighted PDFs (55.3 MB) sat tracked on the default branch
# of this PUBLIC repo for weeks. CLAUDE.md had forbidden them the whole time.
# See docs/DECISIONS.md, 2026-09-01.
#
# Bypass deliberately with:  git commit --no-verify

set -e

# Prefer whatever python is on PATH; skip rather than block if none is found.
if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "pre-commit: no python found; skipping repo-rule checks" >&2
  exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)

PYTHONIOENCODING=utf-8 "$PY" "$REPO_ROOT/tools/check_repo_rules.py" --staged || {
  echo "" >&2
  echo "pre-commit: blocked. Fix the above, or bypass with --no-verify if you mean it." >&2
  exit 1
}

exit 0
